{
  "schemaVersion": 1,
  "id": "yiyiaddon",
  "version": "${version}",
  "name": "yiyiaddon",
  "description": "yiyiaddon 的 Meteor Client 功能扩展与界面汉化。",
  "authors": [
    "yiyijia"
  ],
  "contact": {
    "sources": "https://github.com/yiyijia/yiyiaddon"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.example.addon.core.AddonTemplate"
    ]
  },
  "mixins": [
    "addon-template.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/baritone-fabric-26.1.2.jar"
    }
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
